#!/usr/bin/env zsh
# Picker for every tmux pane running Claude Code, Codex or OpenCode.
#   bind A run-shell -b "~/.config/tmux/bin/agent-panes '#{client_name}'"
#
# Keys: j/k or arrows move · Enter jump to pane · Delete/Backspace/x kill agent (back to shell)
#       X kill all (asks y/n) · q/Esc close. Refreshes every second.

source ${0:A:h}/picker.zsh "$@"

picker_title=agents
picker_empty="No Claude Code, Codex or OpenCode panes running."
hints=('↵' jump '⌫' kill X 'kill all' q close)

# Order: waiting on a permission prompt or question, then idle (waiting for the
# next message), then working, then agents without state (Codex, OpenCode).
# Inside each group, most recent interaction first. Both come from the
# @agent_attention / @agent_last pane options set by Claude Code hooks
# (tmux/bin/agent-mark).
load() {
  local keep=${ids[sel]} s line US=$'\x1f'  # unit separator: keeps empty fields
  ids=() targets=() cmds=() titles=() states=() lasts=()
  busy=0 waiting=0 idle=0
  local id target cmd last att title state rank
  local -a found
  while IFS=$US read -r id target cmd last att title; do
    (( ${agents[(Ie)$cmd]} )) || continue
    # Claude Code titles start with ✳ when idle, a braille spinner when working.
    case $title in
      ✳*) state=idle; title=${title#✳} ;;
      [⠀-⣿]*) state=busy; title=${title:1} ;;
      *) state=unknown ;;
    esac
    [[ $att == 1 ]] && state=ask
    case $state in
      ask) rank=0; (( waiting++ )) ;;
      idle) rank=1; (( idle++ )) ;;
      busy) rank=2; (( busy++ )) ;;
      *) rank=3 ;;
    esac
    found+="$rank$US$(( 9999999999 - ${last:-0} ))$US$id$US$target$US$cmd$US${last:-0}$US$state$US${title## #}"
  done < <(tmux list-panes -a -F "#{pane_id}$US#{session_name}:#{window_name}$US#{pane_current_command}$US#{@agent_last}$US#{@agent_attention}$US#{pane_title}")
  for line in ${(o)found}; do
    IFS=$US read -r _ _ id target cmd last state title <<< "$line"
    ids+=$id targets+=$target cmds+=$cmd lasts+=$last states+=$state titles+=$title
  done
  width=0; for s in $targets; do (( ${#s} > width )) && width=${#s}; done
  # Keep the selection on the same pane when the order changes.
  (( ${ids[(Ie)$keep]} )) && sel=${ids[(Ie)$keep]}
  (( sel > ${#ids} )) && sel=${#ids}
  (( sel < 1 )) && sel=1
}

counts() {
  print -rn -- "$F_fg${#ids}$F_dim running"
  (( waiting )) && print -rn -- "  $F_red● $F_sub$waiting waiting"
  (( busy )) && print -rn -- "  $F_yellow● $F_sub$busy working"
  (( idle )) && print -rn -- "  $F_green● $F_sub$idle idle"
}

row() {  # row <index>
  local i=$1 s=$targets[i] glyph bar bg tcol
  row_style $i
  case $states[i] in
    ask)  glyph="$F_red●" ;;
    busy) glyph="$F_yellow●" ;;
    idle) glyph="$F_green●" ;;
    *)    glyph="$F_dim○" ;;
  esac
  local c=$cmds[i]; local label=${glyphs[$c]}
  [[ -z $label || $AGENT_PICKER_ICONS == 0 ]] && label=${(r:10:: :)c} || label="$label  "
  local agent=${colors[$c]:-$F_sub}$label
  local sess=${s%%:*} win=${s#*:}
  local n=$(( width + 4 - ${#s} )); (( n < 1 )) && n=1
  local pad=${(l:n:: :)} age=${(l:3:: :)$(ago $lasts[i])}
  print -rn -- "$bg$bar $glyph  $agent$BOLD$F_fg$sess$R$bg$F_dim › $F_sub$win$pad$F_dim$age   $tcol${titles[i]}$EOL$R"
}

preview_target() { print -rn -- ${ids[sel]}; }
preview_label() { print -rn -- ${targets[sel]/:/ › }; }

is_agent() { (( ${agents[(Ie)$(tmux display -p -t "$1" '#{pane_current_command}' 2>/dev/null)]} )); }

# Stop the agent the way a user would (Ctrl+C until it exits), then escalate
# to SIGTERM and SIGKILL on the pane's foreground processes if it hangs.
stop_agent() {
  local id=$1 i
  for i in 1 2 3; do
    is_agent "$id" || return 0
    tmux send-keys -t "$id" C-c; sleep 0.15
    tmux send-keys -t "$id" C-c; sleep 0.6
  done
  is_agent "$id" || return 0
  local tty=$(tmux display -p -t "$id" '#{pane_tty}')
  local pids=($(ps -t "${tty#/dev/}" -o pid=,stat= | awk '$2 ~ /\+/ {print $1}'))
  (( ${#pids} )) && kill -TERM $pids 2>/dev/null; sleep 1
  is_agent "$id" && (( ${#pids} )) && kill -KILL $pids 2>/dev/null; sleep 0.2
  ! is_agent "$id"
}

on_key() {
  (( ${#ids} )) || return
  local id all left
  case $key in
    $'\n')
      id=${ids[sel]}
      tmux switch-client -c "$client" -t "$id" \; select-window -t "$id" \; select-pane -t "$id"
      exit 0 ;;
    DEL|x)
      say "Killing ${targets[sel]}…" $F_yellow; draw
      if stop_agent "${ids[sel]}"; then say "Killed ${targets[sel]}." $F_green
      else say "Could not kill ${targets[sel]}." $F_red; fi
      load ;;
    X)
      confirm "Kill all ${#ids} agents?" || return
      say "Killing ${#ids} agents…" $F_yellow; draw
      all=("${ids[@]}")
      for id in $all; do stop_agent "$id" & done
      wait
      left=0; for id in $all; do is_agent "$id" && (( left++ )); done
      if (( left )); then say "$left could not be killed." $F_red
      else say "Killed all ${#all}." $F_green; fi
      load ;;
  esac
}

picker_run
